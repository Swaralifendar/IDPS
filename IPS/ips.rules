)



# ------------------------------------------------------------
# Services
# ------------------------------------------------------------

detect ip any any -> any any (
    sensor:HIDS;
    detection_id:SRV-001;
    severity_at_least:HIGH;
    indicator:payload;
    list:suspicious_service_signatures;
    msg:"IPS Validate - Suspicious New Windows Service";
    sid:320013;
    rev:3;
    category_type:PERSISTENCE;
    priority:1;
)


detect ip any any -> any any (
    sensor:HIDS;
    detection_id:SRV-002;
    min_events:2;
    severity_at_least:MEDIUM;
    indicator:payload;
    list:critical_security_services;
    msg:"IPS Validate - Security Service Terminated";
    sid:320014;
    rev:4;
    category_type:DEFENSE_EVASION;
    priority:2;
)



# ------------------------------------------------------------
# Malware / Defense Evasion
# ------------------------------------------------------------

detect ip any any -> any any (
    sensor:HIDS;
    detection_id:MAL-001;
    severity_at_least:HIGH;
    content:"Defender detected threat";
    nocase;
    msg:"IPS Validate - Windows Defender Malware Detection";
    sid:320015;
    rev:2;
    category_type:MALWARE;
    priority:1;
)


detect ip any any -> any any (
    sensor:HIDS;
    detection_id:MAL-002;
    severity_at_least:CRITICAL;
    content:"Real-Time Protection was disabled";
    nocase;
    msg:"IPS Validate - Defender Real-Time Protection Disabled";
    sid:320016;
    rev:2;
    category_type:DEFENSE_EVASION;
    priority:1;
)


# 5007 fires for every Defender config change (including
# signature updates). Only exclusion keys are validated.
detect ip any any -> any any (
    sensor:HIDS;
    detection_id:MAL-003;
    severity_at_least:HIGH;
    content:"\Exclusions\";
    nocase;
    msg:"IPS Validate - Defender Exclusion Added";
    sid:320017;
    rev:3;
    category_type:DEFENSE_EVASION;
    priority:1;
)


detect ip any any -> any any (
    sensor:HIDS;
    detection_id:LOG-001;
    severity_at_least:CRITICAL;
    content:"Event Log was cleared";
    nocase;
    msg:"IPS Validate - Windows Event Log Cleared";
    sid:320018;
    rev:2;
    category_type:DEFENSE_EVASION;
    priority:1;
)


# Group Policy refreshes change audit policy as the machine
# account (NAME$); those are excluded.
detect ip any any -> any any (
    sensor:HIDS;
    detection_id:AUDIT-001;
    content:"Audit policy for ";
    content_not:"$'";
    nocase;
    min_events:2;
    severity_at_least:HIGH;
    msg:"IPS Validate - Audit Policy Changed";
    sid:320019;
    rev:3;
    category_type:DEFENSE_EVASION;
    priority:1;
)


# Application installers add firewall rules routinely; only a
# larger burst is validated.
detect ip any any -> any any (
    sensor:HIDS;
    detection_id:FW-001;
    content:"Firewall rule ";
    nocase;
    min_events:4;
    severity_at_least:MEDIUM;
    msg:"IPS Validate - Windows Firewall Rules Changed";
    sid:320020;
    rev:4;
    category_type:DEFENSE_EVASION;
    priority:2;
)



# ------------------------------------------------------------
# Persistence
# ------------------------------------------------------------

detect ip any any -> any any (
    sensor:HIDS;
    detection_id:SCHD-001;
    severity_at_least:HIGH;
    indicator:payload;
    list:suspicious_scheduled_task_signatures;
    msg:"IPS Validate - Suspicious Scheduled Task Created";
    sid:320021;
    rev:2;
    category_type:PERSISTENCE;
    priority:1;
)



# ============================================================
# 16. HIGH-CONFIDENCE BLOCKING
# ============================================================
#
# These are the ONLY BLOCK rules. They run inline in the NIDS
# process and only when the packet already raised a NIDS alert.
#
# BLOCK requires:
#
#     NIDS detection on the packet
#          AND
#     all rule conditions
#          AND
#     configured indicator list match
#
# BLOCK rules must not use min_events or severity_at_least:
# the inline path cannot evaluate them and skips the rule.
#
# IP reputation rules have no category_type on purpose: the
# category is a filter, and no NIDS alert carries a
# "threat intelligence" category.
#
# ============================================================


# ------------------------------------------------------------
# Known malicious / C2 IPs (any NIDS detection + exact IOC)
# ------------------------------------------------------------

block ip any any -> any any (
    sensor:NIDS;
    indicator:src_ip;
    list:malicious_ips;
    msg:"IPS Block - Known Malicious Source IP";
    sid:330001;
    rev:2;
    priority:1;
)


block ip any any -> any any (
    sensor:NIDS;
    indicator:dst_ip;
    list:malicious_ips;
    msg:"IPS Block - Known Malicious Destination IP";
    sid:330002;
    rev:2;
    priority:1;
)


block ip any any -> any any (
    sensor:NIDS;
    indicator:src_ip;
    list:c2_ips;
    msg:"IPS Block - Known C2 Source IP";
    sid:330003;
    rev:2;
    priority:1;
)


block ip any any -> any any (
    sensor:NIDS;
    indicator:dst_ip;
    list:c2_ips;
    msg:"IPS Block - Known C2 Destination IP";
    sid:330004;
    rev:2;
    priority:1;
)


# ------------------------------------------------------------
# High-confidence payloads, each tied to its NIDS detection
# ------------------------------------------------------------

block tcp any any -> any any (
    sensor:NIDS;
    detection_id:100025;
    indicator:payload;
    list:malicious_payload_signatures;
    nocase;
    msg:"IPS Block - PowerShell Encoded Command";
    sid:330005;
    rev:2;
    category_type:C2;
    priority:1;
)


block tcp any any -> any 80,443,8080 (
    sensor:NIDS;
    detection_id:100002;
    indicator:payload;
    list:high_confidence_sqli_signatures;
    content_all:"UNION","SELECT";
    nocase;
    msg:"IPS Block - High Confidence SQL Injection";
    sid:330006;
    rev:2;
    category_type:EXPLOIT;
    priority:1;
)


block tcp any any -> any any (
    sensor:NIDS;
    detection_id:100030;
    indicator:payload;
    list:malicious_payload_signatures;
    content:"/dev/tcp/";
    nocase;
    msg:"IPS Block - Interactive Reverse Shell";
    sid:330007;
    rev:1;
    category_type:C2;
    priority:1;
)


block tcp any any -> any 80,443,8080 (
    sensor:NIDS;
    detection_id:100016;
    indicator:payload;
    list:log4j_signatures;
    nocase;
    msg:"IPS Block - Log4j JNDI Exploit";
    sid:330008;
    rev:1;
    category_type:EXPLOIT;
    priority:1;
)
