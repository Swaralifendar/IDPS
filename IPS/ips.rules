# ============================================================
# IDS -> IPS SECOND-STAGE VALIDATION RULES
# ============================================================
#
# IPS does NOT create new attack scenarios.
#
# Every rule maps back to an existing NIDS or HIDS detection.
#
# Required conditions use AND semantics:
#
#   sensor
#   detection_id
#   protocol
#   ports
#   payload
#   flags
#   event count
#   severity
#
# If any explicitly configured condition fails:
#
#       NO IPS DECISION
#
# BLOCK additionally requires the configured indicator list.
#
# ============================================================

# ============================================================
# 2. SQL INJECTION
# ============================================================

detect tcp any any -> any 80,443,8080 (
    sensor:NIDS;
    detection_id:100002;
    content_all:"UNION","SELECT";
    nocase;
    msg:"IPS Validate - SQL UNION SELECT";
    sid:310002;
    rev:1;
    category_type:EXPLOIT;
    priority:1;
)


detect tcp any any -> any 80,443,8080 (
    sensor:NIDS;
    detection_id:100003;
    content:"' OR '1'='1";
    nocase;
    msg:"IPS Validate - SQL Authentication Bypass";
    sid:310003;
    rev:1;
    category_type:EXPLOIT;
    priority:1;
)


detect tcp any any -> any 80,443,8080 (
    sensor:NIDS;
    detection_id:100004;
    content:"SLEEP(";
    nocase;
    msg:"IPS Validate - SQL Time Based Injection";
    sid:310004;
    rev:1;
    category_type:EXPLOIT;
    priority:1;
)



