# ============================================================
# 12. SMB / REDIS / ELASTICSEARCH / FTP / TELNET
# ============================================================

# SAMR is used constantly by domain-joined hosts; only a burst
# (enumeration tools such as SharpHound) is validated.
detect tcp any any -> any 445 (
    sensor:NIDS;
    detection_id:100036;
    min_events:4;
    msg:"IPS Validate - SMB SAMR Enumeration";
    sid:310036;
    rev:3;
    category_type:LATERAL_MOVEMENT;
    priority:2;
)


# Redis RCE pattern: CONFIG SET dir / dbfilename.
# RESP protocol does not send "CONFIG SET" as one string.
detect tcp any any -> any 6379 (
    sensor:NIDS;
    detection_id:100037;
    content_all:"CONFIG","SET";
    content_any:"dir","dbfilename";
    nocase;
    msg:"IPS Validate - Redis CONFIG SET dir/dbfilename";
    sid:310037;
    rev:2;
    category_type:EXPLOIT;
    priority:1;
)


# Legit Elasticsearch queries use scripts; only Java runtime
# access (CVE-2014-3120 / CVE-2015-1427 style) is validated.
detect tcp any any -> any 9200 (
    sensor:NIDS;
    detection_id:100038;
    content_all:"_search","script";
    content_any:"java.lang.runtime","getruntime","processbuilder",".exec(";
    nocase;
    msg:"IPS Validate - Elasticsearch Script Execution";
    sid:310038;
    rev:3;
    category_type:EXPLOIT;
    priority:1;
)


detect tcp any any -> any 21 (
    sensor:NIDS;
    detection_id:100039;
    content:"USER root";
    nocase;
    msg:"IPS Validate - FTP Root Login";
    sid:310039;
    rev:1;
    category_type:UNAUTHORIZED_ACCESS;
    priority:2;
)


detect tcp any any -> any 23 (
    sensor:NIDS;
    detection_id:100040;
    content:"login: root";
    nocase;
    msg:"IPS Validate - Telnet Root Authentication";
    sid:310040;
    rev:2;
    category_type:UNAUTHORIZED_ACCESS;
    priority:2;
)



