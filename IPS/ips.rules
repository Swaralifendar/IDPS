    severity_at_least:HIGH;
    msg:"IPS Validate - Metasploit Handler Port Activity";
    sid:310027;
    rev:3;
    category_type:C2;
    priority:1;
)


# PE header between two non-service (high) ports, as seen with
# Meterpreter stages. Normal HTTP/HTTPS/SMB downloads use a
# well-known port on one side and are excluded.
detect tcp any 1024:65535 -> any 1024:65535 (
    sensor:NIDS;
    detection_id:100028;
    min_events:2;
    msg:"IPS Validate - Meterpreter PE Stage";
    sid:310028;
    rev:2;
    category_type:C2;
    priority:1;
)


# Cobalt Strike default check-in posts binary data.
detect tcp any any -> any any (
    sensor:NIDS;
    detection_id:100029;
    content_all:"POST /submit.php?id=","application/octet-stream";
    nocase;
    msg:"IPS Validate - Cobalt Strike C2 Check-in";
    sid:310029;
    rev:2;
    category_type:C2;
    priority:1;
)



