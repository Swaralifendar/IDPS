# ============================================================
# 15. HIDS VALIDATION
# ============================================================
#
# HIDS events are host events, not network packets.
#
# Therefore:
#
#   sensor:HIDS
#   detection_id:<HIDS RULE>
#
# is used instead of pretending they are TCP/UDP packets.
#
# ============================================================


# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------

detect ip any any -> any any (
    sensor:HIDS;
    detection_id:SEC-001;
    min_events:3;
    severity_at_least:MEDIUM;
    content_any:"LogonType: 3","LogonType: 10","LogonType: 8";
    nocase;
    msg:"IPS Validate - HIDS Failed User Logon";
    sid:320001;
    rev:3;
    category_type:UNAUTHORIZED_ACCESS;
    priority:2;
)


detect ip any any -> any any (
    sensor:HIDS;
    detection_id:AUTH-001;
    min_events:2;
    severity_at_least:MEDIUM;
    indicator:payload;
    list:sensitive_account_signatures;
    msg:"IPS Validate - Explicit Credential Logon";
    sid:320002;
    rev:3;
    category_type:UNAUTHORIZED_ACCESS;
    priority:2;
)


detect ip any any -> any any (
    sensor:HIDS;
    detection_id:LOGON-001;
    min_events:2;
    severity_at_least:MEDIUM;
    content:" from ";
    nocase;
    msg:"IPS Validate - Remote Interactive Logon";
    sid:320003;
    rev:3;
    category_type:UNAUTHORIZED_ACCESS;
    priority:2;
)



# ------------------------------------------------------------
# Privilege / Account Manipulation
# ------------------------------------------------------------

detect ip any any -> any any (
    sensor:HIDS;
    detection_id:PRV-001;
    min_events:2;
    severity_at_least:MEDIUM;
    indicator:payload;
    list:sensitive_privilege_signatures;
    msg:"IPS Validate - Sensitive Privilege Assigned";
    sid:320004;
    rev:3;
    category_type:PRIVILEGE_ESCALATION;
    priority:2;
)


detect ip any any -> any any (
    sensor:HIDS;
    detection_id:PRV-002;
    severity_at_least:HIGH;
    indicator:payload;
    list:administrative_group_signatures;
    msg:"IPS Validate - Security Group Membership Modified";
    sid:320005;
    rev:2;
    category_type:PRIVILEGE_ESCALATION;
    priority:1;
)


detect ip any any -> any any (
    sensor:HIDS;
    detection_id:PRV-003;
    min_events:2;
    severity_at_least:MEDIUM;
    indicator:payload;
    list:sensitive_account_signatures;
    msg:"IPS Validate - New Windows User Account";
    sid:320006;
    rev:2;
    category_type:PERSISTENCE;
    priority:2;
)


