# ============================================================
# 15. HIDS VALIDATION
# ============================================================
#
# HIDS events are host events, not network packets, so the
# header is "ip any any -> any any" and validation uses:
#
#   sensor:HIDS
#   detection_id:<HIDS RULE>
#
# Content conditions match the HIDS "details" text built in
# hids/rule_engine.py (generate_details). Account names are
# matched in their quoted position so that the *actor* (often
# 'Administrator') does not trigger the rule.
#
# ============================================================


# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------

# Network / RDP / cleartext logon failures, brute-force volume.
detect ip any any -> any any (
    sensor:HIDS;
    detection_id:SEC-001;
    content_any:"LogonType: 3","LogonType: 10","LogonType: 8";
    nocase;
    min_events:5;
    severity_at_least:LOW;
    msg:"IPS Validate - HIDS Failed Logon Brute Force";
    sid:320001;
    rev:4;
    category_type:UNAUTHORIZED_ACCESS;
    priority:2;
)


detect ip any any -> any any (
    sensor:HIDS;
    detection_id:AUTH-001;
    content_any:"credentials for 'administrator'","credentials for 'admin'","credentials for 'krbtgt'","credentials for 'guest'","credentials for 'defaultaccount'";
    nocase;
    min_events:3;
    severity_at_least:MEDIUM;
    msg:"IPS Validate - Explicit Credential Logon - Sensitive Account";
    sid:320002;
    rev:4;
    category_type:UNAUTHORIZED_ACCESS;
    priority:2;
)


detect ip any any -> any any (
    sensor:HIDS;
    detection_id:LOGON-001;
    content:" from ";
    nocase;
    min_events:2;
    severity_at_least:MEDIUM;
    msg:"IPS Validate - Remote Interactive Logon";
    sid:320003;
    rev:3;
    category_type:UNAUTHORIZED_ACCESS;
    priority:2;
)



# ------------------------------------------------------------
# Privilege / Account Manipulation
# ------------------------------------------------------------

# 4672 fires on every admin logon; machine accounts (NAME$)
# are excluded and a burst is required.
detect ip any any -> any any (
    sensor:HIDS;
    detection_id:PRV-001;
    indicator:payload;
    list:sensitive_privilege_signatures;
    content_not:"$'";
    min_events:3;
    severity_at_least:MEDIUM;
    msg:"IPS Validate - Sensitive Privilege Assigned";
    sid:320004;
    rev:4;
    category_type:PRIVILEGE_ESCALATION;
    priority:2;
)


detect ip any any -> any any (
    sensor:HIDS;
    detection_id:PRV-002;
    indicator:payload;
    list:administrative_group_signatures;
    severity_at_least:HIGH;
    msg:"IPS Validate - Privileged Group Membership Added";
    sid:320005;
    rev:3;
    category_type:PRIVILEGE_ESCALATION;
    priority:1;
)


# Admin-like names and hidden ($-suffixed) user accounts.
detect ip any any -> any any (
    sensor:HIDS;
    detection_id:PRV-003;
    content_any:"account 'admin","account 'guest'","account 'krbtgt'","account 'defaultaccount'","$' created by";
    nocase;
    severity_at_least:MEDIUM;
    msg:"IPS Validate - Suspicious New User Account";
    sid:320006;
    rev:3;
    category_type:PERSISTENCE;
    priority:2;
)


detect ip any any -> any any (
    sensor:HIDS;
    detection_id:ACC-001;
    content_any:"account 'administrator'","account 'admin'","account 'krbtgt'","account 'guest'";
    nocase;
    severity_at_least:MEDIUM;
    msg:"IPS Validate - Sensitive Account Locked Out";
    sid:320007;
    rev:3;
    category_type:UNAUTHORIZED_ACCESS;
    priority:2;
)


# Re-enabling built-in disabled accounts is a persistence trick.
detect ip any any -> any any (
    sensor:HIDS;
    detection_id:ACC-002;
    content_any:"account 'guest'","account 'administrator'","account 'defaultaccount'","account 'krbtgt'";
    nocase;
    severity_at_least:LOW;
    msg:"IPS Validate - Built-in Account Enabled";
    sid:320008;
    rev:4;
    category_type:PERSISTENCE;
    priority:2;
)


# Disabling built-in accounts is normal hardening; only mass
# disabling (account access removal, T1531) is validated.
detect ip any any -> any any (
    sensor:HIDS;
    detection_id:ACC-003;
    min_events:3;
    severity_at_least:LOW;
    msg:"IPS Validate - Multiple User Accounts Disabled";
    sid:320009;
    rev:4;
    category_type:DEFENSE_EVASION;
    priority:3;
)


detect ip any any -> any any (
    sensor:HIDS;
    detection_id:ACC-004;
    content_any:"for 'administrator'","for 'admin'","for 'krbtgt'","for 'guest'","for 'defaultaccount'";
    nocase;
    severity_at_least:MEDIUM;
    msg:"IPS Validate - Sensitive Account Password Reset";
    sid:320010;
    rev:4;
    category_type:PERSISTENCE;
    priority:2;
)



