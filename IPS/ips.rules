# ------------------------------------------------------------
# Malware / Defense Evasion
# ------------------------------------------------------------

detect ip any any -> any any (
    sensor:HIDS;
    detection_id:MAL-001;
    severity_at_least:HIGH;
    content:"Defender detected threat";
    nocase;
    msg:"IPS Validate - Windows Defender Malware Detection";
    sid:320015;
    rev:2;
    category_type:MALWARE;
    priority:1;
)


detect ip any any -> any any (
    sensor:HIDS;
    detection_id:MAL-002;
    severity_at_least:CRITICAL;
    content:"Real-Time Protection was disabled";
    nocase;
    msg:"IPS Validate - Defender Real-Time Protection Disabled";
    sid:320016;
    rev:2;
    category_type:DEFENSE_EVASION;
    priority:1;
)


detect ip any any -> any any (
    sensor:HIDS;
    detection_id:MAL-003;
    severity_at_least:HIGH;
    content_any:"C:\","C:\\",".exe",".dll","\Temp","\AppData","powershell";
    nocase;
    msg:"IPS Validate - Defender Exclusion Added";
    sid:320017;
    rev:2;
    category_type:DEFENSE_EVASION;
    priority:1;
)


