# ============================================================
# 16. HIGH-CONFIDENCE BLOCKING
# ============================================================
#
# IMPORTANT:
#
# These are the ONLY BLOCK rules.
#
# BLOCK requires:
#
#     indicator condition
#          AND
#     configured indicator list match
#
# No generic port or category detection is allowed to
# directly block.
#
# ============================================================


# ------------------------------------------------------------
# Known malicious source IP
# ------------------------------------------------------------

block ip any any -> any any (
    indicator:src_ip;
    list:malicious_ips;
    msg:"IPS Block - Known Malicious Source IP";
    sid:330001;
    rev:1;
    category_type:THREAT_INTELLIGENCE;
    priority:1;
)


# ------------------------------------------------------------
# Known malicious destination IP
# ------------------------------------------------------------

block ip any any -> any any (
    indicator:dst_ip;
    list:malicious_ips;
    msg:"IPS Block - Known Malicious Destination IP";
    sid:330002;
    rev:1;
    category_type:THREAT_INTELLIGENCE;
    priority:1;
)


# ------------------------------------------------------------
# Known C2 source IP
# ------------------------------------------------------------

block tcp any any -> any any (
    indicator:src_ip;
    list:c2_ips;
    msg:"IPS Block - Known C2 Source IP";
    sid:330003;
    rev:1;
    category_type:C2;
    priority:1;
)


# ------------------------------------------------------------
# Known C2 destination IP
# ------------------------------------------------------------

block tcp any any -> any any (
    indicator:dst_ip;
    list:c2_ips;
    msg:"IPS Block - Known C2 Destination IP";
    sid:330004;
    rev:1;
    category_type:C2;
    priority:1;
)


# ------------------------------------------------------------
# Known malicious payload
# ------------------------------------------------------------

block tcp any any -> any any (
    indicator:payload;
    list:malicious_payload_signatures;
    msg:"IPS Block - Known Malicious Payload Signature";
    sid:330005;
    rev:1;
    category_type:MALWARE;
    priority:1;
)


# ------------------------------------------------------------
# High-confidence SQL injection
# ------------------------------------------------------------

block tcp any any -> any 80,443,8080 (
    indicator:payload;
    list:high_confidence_sqli_signatures;
    content_all:"UNION","SELECT";
    nocase;
    msg:"IPS Block - High Confidence SQL Injection";
    sid:330006;
    rev:1;
    category_type:EXPLOIT;
    priority:1;
)