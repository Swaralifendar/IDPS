    severity_at_least:HIGH;
    indicator:payload;
    list:suspicious_process_signatures;
    msg:"IPS Validate - Suspicious Process Execution";
    sid:320011;
    rev:3;
    category_type:EXPLOIT;
    priority:1;
)


detect ip any any -> any any (
