# ============================================================
# IDS -> IPS SECOND-STAGE VALIDATION RULES
# ============================================================
#
# IPS does NOT create new attack scenarios.
#
# Every rule maps back to an existing NIDS SID or HIDS rule ID
# through detection_id. NIDS 100001 (test rule) and 100066
# (plain ICMP echo) intentionally have no IPS rule.
#
# All configured conditions use AND semantics. If any explicitly
# configured condition fails: NO IPS DECISION.
#
# How each condition is evaluated by ips_engine.py:
#
#   category_type      FILTER, not a label. Must be one of the
#                      categories of the NIDS/HIDS alert, or the
#                      rule never matches.
#
#   detection_id       NIDS SID or HIDS rule ID of the alert.
#
#   content / content_all / content_any / content_not
#                      Substring match on the NIDS payload, or on
#                      the HIDS alert "details" text.
#
#   severity_at_least  Severity of the individual alert:
#                        NIDS priority 1 = HIGH, 2 = MEDIUM, 3 = LOW
#                        HIDS severity from hids/rule_metadata.py
#                      (suppressed HIDS alerts are INFO -> never match)
#
#   min_events         Number of alerts in the correlation bucket
#                      (same category + same IP within the window).
#                      NIDS alerts are per packet.
#
#   indicator + list   Substring (payload) or exact (IP) match
#                      against IPS/indicators.py.
#
# tcp_flags is NOT used: NIDS stores flags as a dict, so the IPS
# comparison can never match. The NIDS SID already guarantees the
# flag combination.
#
# DETECT rules produce ALERT decisions (correlation path only).
# BLOCK rules are the only rules that drop traffic (inline path).
#
# ============================================================


# ============================================================
# 1. SQL INJECTION
# ============================================================

detect tcp any any -> any 80,443,8080 (
    sensor:NIDS;
    detection_id:100002;
    content_all:"UNION","SELECT";
    content_any:"union select","union all select","union+select","union+all+select","union%20select","union%20all%20select","union/**/select";
    nocase;
    msg:"IPS Validate - SQL UNION SELECT";
    sid:310002;
    rev:2;
    category_type:EXPLOIT;
    priority:1;
)


detect tcp any any -> any 80,443,8080 (
    sensor:NIDS;
    detection_id:100003;
    content:"' OR '1'='1";
    nocase;
    msg:"IPS Validate - SQL Authentication Bypass";
    sid:310003;
    rev:1;
    category_type:EXPLOIT;
    priority:1;
)


detect tcp any any -> any 80,443,8080 (
    sensor:NIDS;
    detection_id:100004;
    content:"SLEEP(";
    content_any:"and sleep(","or sleep(","select sleep(","+sleep(","%20sleep(","'sleep(","(sleep(","pg_sleep(";
    nocase;
    msg:"IPS Validate - SQL Time Based Injection";
    sid:310004;
    rev:2;
    category_type:EXPLOIT;
    priority:1;
)



